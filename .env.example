# ============================================
# Configuración de DevSecOps
# Secure Coding Dojo v2.0
# ============================================

# Base de Datos
# Para Docker: usar 'db' como host
# Para desarrollo local: usar 'localhost'
DATABASE_URL=postgresql+asyncpg://secure_dojo:secure_dojo_pass@db:5432/secure_coding_dojo

# Frontend API Target
# Para Docker: usar 'http://backend:8000'
# Para desarrollo local: usar 'http://localhost:8000'
VITE_API_TARGET=http://backend:8000

# Secret Key (cambiar en producción)
SECRET_KEY=your-secret-key-change-this-in-production

# Entorno
ENVIRONMENT=development
DEBUG=True

# ============================================
# INSTRUCCIONES:
# ============================================
# 1. Para desarrollo con Docker Compose:
#    - Mantén los valores por defecto
#    - Ejecuta: docker-compose up --build
#
# 2. Para desarrollo local sin Docker:
#    - DATABASE_URL=postgresql+asyncpg://secure_dojo:secure_dojo_pass@localhost:5432/secure_coding_dojo
#    - VITE_API_TARGET=http://localhost:8000
#    - Asegúrate que PostgreSQL esté corriendo en localhost:5432
#    - Ejecuta backend y frontend por separado
# ============================================
